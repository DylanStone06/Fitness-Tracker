@* The account links on the right of the header. *@
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="navbar-text account-email me-sm-2"><span class="visually-hidden">Signed in as </span>@User.Identity.Name</span>
        </li>
        <li class="nav-item">
            @* A form, not a link: signing out changes state, so it needs a POST with the anti-forgery token. *@
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link">Sign out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Register">Create an account</a>
        </li>
    }
</ul>
