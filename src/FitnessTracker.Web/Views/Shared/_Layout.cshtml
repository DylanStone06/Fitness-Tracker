@inject FitnessTracker.Web.Services.UserAppearance UserAppearance
@{
    // ACC-3, Appearance: the page arrives dark or light. "Match my device" arrives light, and js/theme.js switches it
    // to the device's setting before it is drawn (it stays light without JavaScript). data-theme names the choice.
    var appearance = await UserAppearance.CurrentAsync(Context);
    var followsDevice = appearance == FitnessTracker.Web.Data.Appearance.Device;
    var theme = appearance == FitnessTracker.Web.Data.Appearance.Dark ? "dark" : "light";
}
<!DOCTYPE html>
<html lang="en-GB" data-bs-theme="@theme" data-theme="@appearance.ToString().ToLowerInvariant()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* "Error:" first after an unsuccessful form submit, so screen reader users hear about it as the page loads. *@
    <title>@(ViewData.ModelState.IsValid ? "" : "Error: ")@ViewData["Title"] - Fitness Tracker</title>
    <meta name="color-scheme" content="@(followsDevice ? "light dark" : theme)" />
    @if (followsDevice)
    {
        <script src="~/js/theme.js" asp-append-version="true"></script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitnessTracker.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @{
        // The menu marks the section you're in: aria-current "page" on that section's own page, "true" on the pages
        // within it. The default times page is opened from Preferences, so it counts as Preferences.
        var controller = ViewContext.RouteData.Values["controller"] as string;
        var action = ViewContext.RouteData.Values["action"] as string;
        var section = controller == "CategoryBuffers" ? "Preferences" : controller;
        string? Current(string name) =>
            section != name ? null
            : controller == name && action == "Index" ? "page"
            : name == "Home" ? null
            : "true";
    }
    <a class="visually-hidden-focusable" href="#main">Skip to main content</a>
    <header class="site-header sticky-top border-bottom mb-4">
        <nav class="navbar navbar-expand-sm" aria-label="Main">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <svg class="brand-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                        <defs>
                            <linearGradient id="brand-gradient" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#2563eb" />
                                <stop offset="1" stop-color="#15803d" />
                            </linearGradient>
                        </defs>
                        <rect width="28" height="28" rx="8" fill="url(#brand-gradient)" />
                        <path d="M5 15h4l2.5-5 4 9 2.5-5H23" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    Fitness Tracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav"
                        aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="main-nav">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(Current("Home") is null ? null : "active")" aria-current="@Current("Home")" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("Calendar") is null ? null : "active")" aria-current="@Current("Calendar")" asp-controller="Calendar" asp-action="Index">Calendar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("Activities") is null ? null : "active")" aria-current="@Current("Activities")" asp-controller="Activities" asp-action="Index">Activities</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("Goals") is null ? null : "active")" aria-current="@Current("Goals")" asp-controller="Goals" asp-action="Index">Goals</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("Locations") is null ? null : "active")" aria-current="@Current("Locations")" asp-controller="Locations" asp-action="Index">Locations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("TravelLegs") is null ? null : "active")" aria-current="@Current("TravelLegs")" asp-controller="TravelLegs" asp-action="Index">Travel times</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(Current("Preferences") is null ? null : "active")" aria-current="@Current("Preferences")" asp-controller="Preferences" asp-action="Index">Preferences</a>
                            </li>
                        }
                    </ul>
                    <partial name="_AccountPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main id="main" class="pb-3" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
