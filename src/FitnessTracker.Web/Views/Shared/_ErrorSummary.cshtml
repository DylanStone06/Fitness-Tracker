@* Lists every problem at the top of a form after an unsuccessful submit, in the order of the fields (GOV.UK error
   pattern). A problem with one field links to it, so keyboard and screen reader users can jump straight there; a
   problem with the whole form is plain text. Shown only when there are errors. *@
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <h2 class="h5">There is a problem</h2>
        <div class="validation-summary-errors mb-0">
            <ul class="mb-0">
                @foreach (var (field, message) in ViewData.ModelState.ProblemsInFieldOrder(ViewData.ModelMetadata))
                {
                    if (field.Length == 0)
                    {
                        <li>@message</li>
                    }
                    else
                    {
                        <li><a href="#@Html.GenerateIdFromName(field)">@message</a></li>
                    }
                }
            </ul>
        </div>
    </div>
}
