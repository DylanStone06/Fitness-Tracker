@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <h1>Sign in</h1>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <partial name="_ErrorSummary" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <span asp-validation-for="Email" class="d-block text-danger" id="email-error"></span>
                <input asp-for="Email" class="form-control" autocomplete="username" spellcheck="false"
                       aria-describedby="email-error" aria-invalid="@ViewData.ModelState.AriaInvalid("Email")" />
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <span asp-validation-for="Password" class="d-block text-danger" id="password-error"></span>
                <input asp-for="Password" class="form-control" autocomplete="current-password"
                       aria-describedby="password-error" aria-invalid="@ViewData.ModelState.AriaInvalid("Password")" />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>

        <p class="mt-4">New here? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
