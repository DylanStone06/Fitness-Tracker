@model ActivityFormViewModel
@{
    ViewData["Title"] = "Add an activity";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <h1>Add an activity</h1>
        <p>Anything that takes up your time: work, the gym, a run, meal prep, seeing friends.</p>

        <form asp-action="Create" method="post" novalidate>
            <partial name="_ErrorSummary" />
            <partial name="_ActivityFields" />

            <button type="submit" class="btn btn-primary">Add activity</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
