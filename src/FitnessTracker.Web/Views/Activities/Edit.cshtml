@model ActivityFormViewModel
@{
    ViewData["Title"] = "Edit activity";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        <h1>Edit activity</h1>

        @* Posts back to this page's own address, which carries the activity's id. *@
        <form asp-action="Edit" method="post" novalidate>
            <partial name="_ErrorSummary" />
            <input type="hidden" asp-for="Version" />
            <input type="hidden" asp-for="ReturnToCalendar" />
            <partial name="_ActivityFields" />

            <button type="submit" class="btn btn-primary">Save changes</button>
            @if (Model.ReturnToCalendar)
            {
                <a class="btn btn-link" asp-controller="Calendar" asp-action="Index" asp-route-date="@Model.SavedStartDate">Cancel</a>
            }
            else
            {
                <a class="btn btn-link" asp-action="Index">Cancel</a>
            }
        </form>
    </div>
</div>
