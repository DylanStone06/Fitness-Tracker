@model FitnessTracker.Web.Models.Workouts.SessionLogViewModel
@using FitnessTracker.Domain.Workouts
@using FitnessTracker.Web.Models.Workouts
@{
    ViewData["Title"] = "Session";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        @* dir="auto": a title in Arabic or Hebrew reads right to left (break-ui, Phase 6). *@
        <h1 class="text-break" dir="auto">@Model.Title</h1>
        <p class="mb-1">@Model.When</p>
        <p class="fs-5 mb-1">Status: @Model.Status</p>
        @if (Model.NotLogged)
        {
            @* T20: shown only; it stays planned until marked (FIT-1). *@
            <p>Not logged: its time has passed, and it isn't marked done or skipped.</p>
        }

        @if (Model.Details is { } details)
        {
            @* FIT-3, FIT-4: a run or other activity as saved (a run's pace worked out: Q25). Only the figures given show. *@
            <section class="card mt-3" aria-labelledby="details-heading">
                <div class="card-body">
                    <h2 class="h5 text-break @(details.Figures.Count > 0 ? "mb-3" : "mb-0")" id="details-heading" dir="auto">@details.Heading</h2>
                    @if (details.Figures.Count > 0)
                    {
                        <partial name="_Figures" model="details.Figures" />
                    }
                </div>
            </section>
        }

        @if (Model.Workout is { } workout)
        {
            @* FIT-2: the workout as saved: how much in all, then each exercise with its sets in order. *@
            <section class="card mt-3" aria-labelledby="workout-heading">
                <div class="card-body">
                    <h2 class="h5 mb-3" id="workout-heading">Your workout</h2>
                    <partial name="_Figures" model="workout.Figures" />
                    @foreach (var exercise in workout.Exercises)
                    {
                        <h3 class="h6 mt-3 mb-1 text-break" dir="auto">@exercise.Name</h3>
                        <ul class="ft-sets">
                            @foreach (var set in exercise.Sets)
                            {
                                <li>@set</li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        @* Posts back to this page's own address, which carries the activity's id; the date says which session. *@
        <form asp-action="Log" method="post" novalidate class="mt-3">
            <partial name="_ErrorSummary" />
            <input type="hidden" asp-for="Date" />
            <input type="hidden" asp-for="Version" />

            @if ((Model.IsRun || Model.IsOther) && Model.CanMarkDone)
            {
                @* FIT-3, FIT-4: what the run or other activity was like (Q26, Q34). Once saved with details, folded away
                   under "Change the details" (P7: detail on demand), and opened again when what was typed needs fixing. *@
                var fields = Model.IsRun ? "_RunFields" : "_OtherFields";
                if (Model.Details is not null)
                {
                    <details class="card mb-3 ft-fold" open="@(!ViewData.ModelState.IsValid)">
                        <summary>Change the details</summary>
                        <div class="card-body pt-1">
                            <partial name="@fields" />
                            <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">Save changes</button>
                        </div>
                    </details>
                }
                else
                {
                    <section class="card mb-3" aria-labelledby="log-heading">
                        <div class="card-body">
                            <h2 class="h5 mb-1" id="log-heading">@(Model.IsRun ? "Log this run" : "Log this activity")</h2>
                            <p class="form-text mt-0 mb-3">@(Model.IsRun ? "Everything is optional. The pace is worked out from the time and distance." : "Everything is optional.")</p>
                            <partial name="@fields" />
                            <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">@(Model.Marked == SessionMark.Done ? "Save" : "Save as done")</button>
                        </div>
                    </section>
                }
            }

            @if (Model.IsGym && Model.CanMarkDone)
            {
                @* FIT-2: the workout's sets (Q31). Once saved, folded away under "Change the workout" (P7), and opened
                   again when what was typed needs fixing. Save comes before "Add more rows", so Enter in a box saves. *@
                if (Model.Workout is not null)
                {
                    <details class="card mb-3 ft-fold" open="@(!ViewData.ModelState.IsValid)">
                        <summary>Change the workout</summary>
                        <div class="card-body pt-1">
                            <partial name="_SetRows" />
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">Save changes</button>
                                <button type="submit" name="MoreRows" value="true" class="btn btn-outline-secondary">Add more rows</button>
                            </div>
                        </div>
                    </details>
                }
                else
                {
                    <section class="card mb-3" aria-labelledby="log-heading">
                        <div class="card-body">
                            <h2 class="h5 mb-1" id="log-heading">Log this workout</h2>
                            <p class="form-text mt-0 mb-3">One row a set, in the order you did them; leave the rest blank. Weight is optional (bodyweight), and so is the rest after a set.</p>
                            <partial name="_SetRows" />
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">@(Model.Marked == SessionMark.Done ? "Save" : "Save as done")</button>
                                <button type="submit" name="MoreRows" value="true" class="btn btn-outline-secondary">Add more rows</button>
                            </div>
                        </div>
                    </section>
                }
            }

            @* FIT-2: notes on any session, saved with its mark; once marked, "Save notes" keeps the mark. *@
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                @if (Model.Marked is null)
                {
                    <div class="form-text mt-0 mb-1" id="notes-hint">Saved when you mark it done or skipped.</div>
                }
                <span asp-validation-for="Notes" class="d-block text-danger" id="notes-error"></span>
                <textarea asp-for="Notes" class="form-control" rows="3" dir="auto"
                          aria-describedby="@(Model.Marked is null ? "notes-hint " : "")notes-error" aria-invalid="@ViewData.ModelState.AriaInvalid("Notes")"></textarea>
            </div>

            <div class="d-flex flex-wrap gap-2">
                @* Every exercise category has its own form, with its own save; this is for any kind added without one. *@
                @if (!Model.IsRun && !Model.IsGym && !Model.IsOther && Model.Marked != SessionMark.Done && Model.CanMarkDone)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">Mark as done</button>
                }
                @if (Model.Marked is { } marked)
                {
                    <button type="submit" name="Mark" value="@(marked == SessionMark.Done ? SessionChoice.Done : SessionChoice.Skipped)" class="btn btn-outline-primary">Save notes</button>
                }
                @if (Model.Marked != SessionMark.Skipped)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Skipped" class="btn btn-outline-secondary">Mark as skipped</button>
                }
                @if (Model.Marked is not null)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Planned" class="btn btn-outline-secondary">Back to planned</button>
                }
            </div>
            @if (Model.Details is not null)
            {
                @* Q28 *@
                <p class="form-text">Marking it skipped or back to planned removes @(Model.IsRun ? "the run's" : "its") details.</p>
            }
            @if (Model.Workout is not null)
            {
                <p class="form-text">Marking it skipped or back to planned removes the workout's sets.</p>
            }
            @if (!Model.CanMarkDone)
            {
                <p class="form-text">It can be marked done once it has started.</p>
            }
        </form>

        <p class="mt-3"><a asp-controller="Activities" asp-action="Occurrence" asp-route-id="@Model.ActivityId" asp-route-date="@Model.Date">Change or move this session</a></p>
    </div>
</div>
