@model FitnessTracker.Web.Models.Workouts.SessionLogViewModel
@using FitnessTracker.Domain.Workouts
@using FitnessTracker.Web.Models.Workouts
@{
    ViewData["Title"] = "Session";
}

<div class="row">
    <div class="col-md-8 col-lg-6">
        @* dir="auto": a title in Arabic or Hebrew reads right to left (break-ui, Phase 6). *@
        <h1 class="text-break" dir="auto">@Model.Title</h1>
        <p class="mb-1">@Model.When</p>
        <p class="fs-5 mb-1">Status: @Model.Status</p>
        @if (Model.NotLogged)
        {
            @* T20: shown only; it stays planned until marked (FIT-1). *@
            <p>Not logged: its time has passed, and it isn't marked done or skipped.</p>
        }

        @* Posts back to this page's own address, which carries the activity's id; the date says which session. *@
        <form asp-action="Log" method="post" novalidate class="mt-3">
            <partial name="_ErrorSummary" />
            <input type="hidden" asp-for="Date" />
            <div class="d-flex flex-wrap gap-2">
                @if (Model.Marked != SessionMark.Done && Model.CanMarkDone)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Done" class="btn btn-primary">Mark as done</button>
                }
                @if (Model.Marked != SessionMark.Skipped)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Skipped" class="btn btn-outline-secondary">Mark as skipped</button>
                }
                @if (Model.Marked is not null)
                {
                    <button type="submit" name="Mark" value="@SessionChoice.Planned" class="btn btn-outline-secondary">Back to planned</button>
                }
            </div>
            @if (!Model.CanMarkDone)
            {
                <p class="form-text">It can be marked done once it has started.</p>
            }
        </form>

        <p class="mt-3"><a asp-controller="Activities" asp-action="Occurrence" asp-route-id="@Model.ActivityId" asp-route-date="@Model.Date">Change or move this session</a></p>
    </div>
</div>
