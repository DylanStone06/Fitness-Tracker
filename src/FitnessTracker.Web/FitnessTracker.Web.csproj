<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Development settings, such as the local database's connection string, live in .NET user-secrets
         (%APPDATA%\Microsoft\UserSecrets\<this id>), outside the repository. -->
    <UserSecretsId>3a7111cc-5956-434d-bf69-15a5bae7916f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Only needed by dotnet-ef to create migrations; PrivateAssets stops it flowing to other projects.
         Its files (about 16 MB, mostly the Roslyn compiler) are still copied to the app's output: keeping
         them out of a published build is part of the hosting work in Phase 9. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitnessTracker.Domain\FitnessTracker.Domain.csproj" />
  </ItemGroup>

</Project>
